provision Provision1 {
  condition "The manufacturer shall establish, document and maintain throughout the life-cycle an ongoing process for identifying hazards associated with a medical device, estimating and evaluating the associated risks, controlling these risks , and monitoring the effectiveness of the controls."
  modality SHALL
  reference {
    ISO14971-doc-ref3-1
  }
}

provision Provision6 {
  condition "Where a documented product realization process exists, such as that described in Clause 7 of ISO 13485:2003 [8] , it shall incorporate the appropriate parts of the risk management process"
  modality SHALL
  reference {
    ISO14971-doc-ref3-1
  }
}

provision Provision7 {
  condition "Compliance is checked by inspection of appropriate documents"
  modality SHALL
  reference {
    ISO14971-doc-ref3-1
  }
}

provision Provision8 {
  condition "Top management shall provide evidence of its commitment to the risk management process"
  modality SHALL
  reference {
    ISO14971-doc-ref3-2
  }
}

provision Provision9 {
  condition "Top management shall provide evidence of its commitment to the risk management process by ensuring the provision of adequate resources"
  modality SHALL
  reference {
    ISO14971-doc-ref3-2
  }
}

provision Provision10 {
  condition "Top management shall provide evidence of its commitment to the risk management process by ensuring the assignment of qualified personnel (see 3.3 ) for risk management"
  modality SHALL
  reference {
    ISO14971-doc-ref3-2
  }
}

provision Provision11 {
  condition "Top management shall define and document the policy for determining criteria for risk acceptability"
  modality SHALL
  reference {
    ISO14971-doc-ref3-2
  }
}

provision Provision12 {
  condition "This policy shall ensure that criteria are based upon applicable national or regional regulations and relevant International Standards, and take into account available information such as the generally accepted state of the art and known stakeholder concerns"
  modality SHALL
  reference {
    ISO14971-doc-ref3-2
  }
}

provision Provision13 {
  condition "Top management shall review the suitability of the risk management process at planned intervals to ensure continuing effectiveness of the risk management process and document any decisions and actions taken"
  modality SHALL
  reference {
    ISO14971-doc-ref3-2
  }
}

provision Provision14 {
  condition "If the manufacturer has a quality management system in place, this review may be part of the quality management system review"
  modality MAY
  reference {
    ISO14971-doc-ref3-2
  }
}

provision Provision4 {
  condition "The risk management process shall include risk control"
  modality SHALL
  reference {
    ISO14971-doc-ref3-1
  }
}

provision Provision15 {
  condition "Compliance is checked by inspection of the appropriate documents"
  modality SHALL
  reference {
    ISO14971-doc-ref3-2
  }
}

provision Provision20 {
  condition "Risk management activities shall be planned"
  modality SHALL
  reference {
    ISO14971-doc-ref3-4
  }
}

provision Provision24 {
  condition "For the particular medical device being considered, the manufacturer shall establish and maintain a risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref3-5
  }
}

provision Provision26 {
  condition "The implementation of the planned risk analysis activities and the results of the risk analysis shall be recorded in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref4-1
  }
}

provision Provision23 {
  condition "If the plan changes during the life-cycle of the medical device , a record of the changes shall be maintained in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref3-4
  }
}

provision Provision3 {
  condition "The risk management process shall include risk evaluation"
  modality SHALL
  reference {
    ISO14971-doc-ref3-1
  }
}

provision Provision43 {
  condition "The manufacturer shall identify risk control measure(s) that are appropriate for reducing the risk (s) to an acceptable level"
  modality SHALL
  reference {
    ISO14971-doc-ref6-2
  }
}

provision Provision44 {
  condition "The manufacturer shall use one or more of the following risk control options in the priority order listed:
a) inherent safety by design;
b) protective measures in the medical device itself or in the manufacturing process;
c) information for safety"
  modality SHALL
  reference {
    ISO14971-doc-ref6-2
  }
}

provision Provision47 {
  condition "The manufacturer shall implement the risk control measure(s) selected in 6.2"
  modality SHALL
  reference {
    ISO14971-doc-ref6-3
  }
}

provision Provision48 {
  condition "Implementation of each risk control measure shall be verified. This verification shall be recorded in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref6-3
  }
}

provision Provision49 {
  condition "The effectiveness of the risk control measure(s) shall be verified and the results shall be recorded in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref6-3
  }
}

provision Provision50 {
  condition "Compliance is checked by inspection of the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref6-3
  }
}

provision Provision45 {
  condition "Compliance is checked by inspection of the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref6-2
  }
}

provision Provision53 {
  condition "If the residual risk is not judged acceptable using these criteria, further risk control measures shall be applied (see 6.2 )"
  modality SHALL
  reference {
    ISO14971-doc-ref6-4
  }
}

provision Provision55 {
  condition "For residual risks that are judged acceptable, the manufacturer shall decide which residual risks to disclose and what information is necessary to include in the accompanying documents in order to disclose those residual risks"
  modality SHALL
  reference {
    ISO14971-doc-ref6-4
  }
}

provision Provision56 {
  condition "Compliance is checked by inspection of the risk management file and the accompanying documents"
  modality SHALL
  reference {
    ISO14971-doc-ref6-4
  }
}

provision Provision40 {
  condition "For each identified hazardous situation , the manufacturer shall decide, using the criteria defined in the risk management plan, if risk reduction is required"
  modality SHALL
  reference {
    ISO14971-doc-ref5
  }
}

provision Provision41 {
  condition "The results of this risk evaluation shall be recorded in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref5
  }
}

provision Provision42 {
  condition "Compliance is checked by inspection of the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref5
  }
}

provision Provision28 {
  condition "For the particular medical device being considered, the manufacturer shall document the intended use and reasonably foreseeable misuse"
  modality SHALL
  reference {
    ISO14971-doc-ref4-2
  }
}

provision Provision29 {
  condition "The manufacturer shall identify and document those qualitative and quantitative characteristics that could affect the safety of the medical device and, where appropriate, their defined limits"
  modality SHALL
  reference {
    ISO14971-doc-ref4-2
  }
}

provision Provision30 {
  condition "This documentation shall be maintained in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref4-2
  }
}

provision Provision31 {
  condition "Compliance is checked by inspection of the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref4-2
  }
}

provision Provision32 {
  condition "The manufacturer shall compile documentation on known and foreseeable hazards associated with the medical device in both normal and fault conditions"
  modality SHALL
  reference {
    ISO14971-doc-ref4-3
  }
}

provision Provision33 {
  condition "This documentation shall be maintained in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref4-3
  }
}

provision Provision34 {
  condition "Compliance is checked by inspection of the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref4-3
  }
}

provision Provision35 {
  condition "Reasonably foreseeable sequences or combinations of events that can result in a hazardous situation shall be considered and the resulting hazardous situation (s) shall be recorded"
  modality SHALL
  reference {
    ISO14971-doc-ref4-4
  }
}

provision Provision39 {
  condition "Compliance is checked by inspection of the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref4-4
  }
}

provision Provision36 {
  condition "For each identified hazardous situation , the associated risk (s) shall be estimated using available information or data"
  modality SHALL
  reference {
    ISO14971-doc-ref4-4
  }
}

provision Provision37 {
  condition "For hazardous situations for which the probability of the occurrence of harm cannot be estimated, the possible consequences shall be listed for use in risk evaluation and risk control"
  modality SHALL
  reference {
    ISO14971-doc-ref4-4
  }
}

provision Provision38 {
  condition "The results of these activities shall be recorded in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref4-4
  }
}

provision Provision16 {
  condition "Persons performing risk management tasks shall have the knowledge and experience appropriate to the tasks assigned to them"
  modality SHALL
  reference {
    ISO14971-doc-ref3-3
  }
}

provision Provision17 {
  condition "These shall include, where appropriate, knowledge and experience of the particular medical device (or similar medical devices ) and its use, the technologies involved or risk management techniques"
  modality SHALL
  reference {
    ISO14971-doc-ref3-3
  }
}

provision Provision18 {
  condition "Appropriate qualification records shall be maintained"
  modality SHALL
  reference {
    ISO14971-doc-ref3-3
  }
}

provision Provision19 {
  condition "Compliance is checked by inspection of the appropriate records"
  modality SHALL
  reference {
    ISO14971-doc-ref3-3
  }
}

provision Provision2 {
  condition "The risk management process shall include risk analysis"
  modality SHALL
  reference {
    ISO14971-doc-ref3-1
  }
}

provision Provision25 {
  condition "Risk analysis shall be performed for the particular medical device as described in 4.2 to 4.4"
  modality SHALL
  reference {
    ISO14971-doc-ref4-1
  }
}

provision Provision27 {
  condition "Compliance is checked by inspection of the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref4-1
  }
}

provision Provision46 {
  condition "If, during risk control option analysis, the manufacturer determines that required risk reduction is not practicable, the manufacturer shall conduct a risk/benefit analysis of the residual risk (proceed to 6.5)"
  modality SHALL
  reference {
    ISO14971-doc-ref6-2
  }
}

provision Provision58 {
  condition "Compliance is checked by inspection of the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref6-5
  }
}

provision Provision62 {
  condition "The effects of the risk control measures shall be reviewed with regard to the introduction of new hazards or hazardous situations"
  modality SHALL
  reference {
    ISO14971-doc-ref6-6
  }
}

provision Provision63 {
  condition "The effects of the risk control measures shall be reviewed with regard to whether the estimated risks for previously identified hazardous situations are affected by the introduction of the risk control measures"
  modality SHALL
  reference {
    ISO14971-doc-ref6-6
  }
}

provision Provision61 {
  condition "The effects of the risk control measures shall be reviewed"
  modality SHALL
  reference {
    ISO14971-doc-ref6-6
  }
}

provision Provision64 {
  condition "Compliance is checked by inspection of the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref6-7
  }
}

provision Provision65 {
  condition "The manufacturer shall ensure that the risk (s) from all identified hazardous situations have been considered. The results of this activity shall be recorded in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref6-7
  }
}

provision Provision66 {
  condition "Compliance is checked by inspection of the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref6-7
  }
}

provision Provision51 {
  condition "After the risk control measures are applied, any residual risk shall be evaluated using the criteria defined in the risk management plan"
  modality SHALL
  reference {
    ISO14971-doc-ref6-4
  }
}

provision Provision52 {
  condition "The results of this evaluation shall be recorded in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref6-4
  }
}

provision Provision54 {
  condition "Compliance is checked by inspection of the risk management file and the accompanying documents"
  modality SHALL
  reference {
    ISO14971-doc-ref6-4
  }
}

provision Provision57 {
  condition "The manufacturer may gather and review data and literature to determine if the medical benefits of the intended use outweigh the residual risk"
  modality MAY
  reference {
    ISO14971-doc-ref6-5
    ISO14971-doc-ref7
  }
}

provision Provision67 {
  condition "the risk remains unacceptable"
  modality SHALL
  reference {
    ISO14971-doc-ref6-5
    ISO14971-doc-ref7
  }
}

provision Provision60 {
  condition "For risks that are demonstrated to be outweighed by the benefits, the manufacturer shall decide which information for safety is necessary to disclose the residual risk"
  modality SHALL
  reference {
    ISO14971-doc-ref6-5
    ISO14971-doc-ref7
  }
}

provision Provision59 {
  condition "The results of this evaluation shall be recorded in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref6-5
    ISO14971-doc-ref7
  }
}

provision Provision69 {
  condition "This review shall at least ensure that the risk management plan has been appropriately implemented"
  modality SHALL
  reference {
    ISO14971-doc-ref8
  }
}

provision Provision70 {
  condition "This review shall at least ensure that the overall residual risk is acceptable"
  modality SHALL
  reference {
    ISO14971-doc-ref8
  }
}

provision Provision71 {
  condition "This review shall at least ensure that appropriate methods are in place to obtain relevant production and post-production information"
  modality SHALL
  reference {
    ISO14971-doc-ref8
  }
}

provision Provision72 {
  condition "The results of this review shall be recorded as the risk management report and included in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref8
  }
}

provision Provision68 {
  condition "Prior to release for commercial distribution of the medical device, the manufacturer shall carry out a review of the risk management process"
  modality SHALL
  reference {
    ISO14971-doc-ref8
  }
}

provision Provision73 {
  condition "Compliance is checked by inspection of the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref8
  }
}

provision Provision21 {
  condition "For the particular medical device being considered, the manufacturer shall establish and document a risk management plan in accordance with the risk management process"
  modality SHALL
  reference {
    ISO14971-doc-ref3-4
  }
}

provision Provision22 {
  condition "The risk management plan shall be part of the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref3-4
  }
}

provision Provision74 {
  condition "The responsibility for review should be assigned in the risk management plan to persons having the appropriate authority [see 3.4 b) ]"
  modality SHOULD
  reference {
    ISO14971-doc-ref8
  }
}

provision Provision76 {
  condition "When establishing a system to collect and review information about the medical device , the manufacturer should consider the mechanisms by which information generated by the operator, the user, or those accountable for the installation, use and maintenance of the medical device is collected and processed"
  modality SHOULD
  reference {
    ISO14971-doc-ref9
  }
}

provision Provision77 {
  condition "When establishing a system to collect and review information about the medical device , the manufacturer should consider new or revised standards"
  modality SHOULD
  reference {
    ISO14971-doc-ref9
  }
}

provision Provision75 {
  condition "The manufacturer shall establish, document and maintain a system to collect and review information about the medical device or similar devices in the production and the post-production phases"
  modality SHALL
  reference {
    ISO14971-doc-ref9
  }
}

provision Provision78 {
  condition "The system should also collect and review publicly available information about similar medical devices on the market"
  modality SHOULD
  reference {
    ISO14971-doc-ref9
  }
}

provision Provision79 {
  condition "This information shall be evaluated for possible relevance to safety, especially if previously unrecognised hazards or hazardous situations are present"
  modality SHALL
  reference {
    ISO14971-doc-ref9
  }
}

provision Provision80 {
  condition "This information shall be evaluated for possible relevance to safety, especially if the estimated risk(s) arising from a hazardous situation is/are no longer acceptable."
  modality SHALL
  reference {
    ISO14971-doc-ref9
  }
}

provision Provision81 {
  condition "The impact on previously implemented risk management activities shall be evaluated and shall be fed back as an input to the risk management process"
  modality SHALL
  reference {
    ISO14971-doc-ref9
  }
}

provision Provision82 {
  condition "A review of the risk management file for the medical device shall be conducted"
  modality SHALL
  reference {
    ISO14971-doc-ref9
  }
}

provision Provision83 {
  condition "If there is a potential that the residual risk (s) or its acceptability has changed, the impact on previously implemented risk control measures shall be evaluated"
  modality SHALL
  reference {
    ISO14971-doc-ref9
  }
}

provision Provision5 {
  condition "The risk management process shall include production and post-production information"
  modality SHALL
  reference {
    ISO14971-doc-ref3-1
  }
}

provision Provision84 {
  condition "The results of this evaluation shall be recorded in the risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref9
  }
}

