data_registry RiskPlan {
  title "Risk management plan"
  data_class RiskPlan#data
}

class RiskPlan#data {
  scope {
    definition "the scope of the planned risk management activities, identifying and describing the medical device and the life-cycle phases for which each element of the plan is applicable"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
  assignment {
    definition "assignment of responsibilities and authorities"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
  requirements {
    definition "requirements for review of risk management activities"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
  criteria {
    definition "criteria for risk acceptability, based on the manufacturer's policy for determining acceptable risk, including criteria for accepting risks when the probability of occurrence of harm cannot be estimated"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
  verification activities {
    definition "verification activities"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
  activities {
    definition "activities related to collection and review of relevant production and post-production information"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
}

