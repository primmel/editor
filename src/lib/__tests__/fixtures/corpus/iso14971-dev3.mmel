    }
  }
  analysis: reference(RiskAnalysisRecord) {
    definition "Risk analysis"
    modality SHALL
    reference {
      ISO14971-doc-ref4-1
    }
  }
  device: reference(MedicalDevice) {
    definition "characteristics related to the safety of the medical device"
    modality SHALL
    reference {
      ISO14971-doc-ref4-2
    }
  }
  hazards: reference(Hazards) {
    definition "Known and foreseeable hazards associated with the medical device in both normal and fault conditions"
    modality SHALL
  }
  evaluation: reference(RiskEvaluationResult) {
    definition "Risk evaluation results"
    modality SHALL
    reference {
      ISO14971-doc-ref5
    }
  }
  control: reference(RiskControlRecord) {
    definition "Risk control records"
    modality SHALL
    reference {
      ISO14971-doc-ref6-2
    }
  }
  review: reference(RiskControlMeasureReview) {
    definition "Result of risk control measure review"
    modality SHALL
    reference {
      ISO14971-doc-ref6-6
    }
  }
  post-productionEvaluation: reference(Post-ProductionEvaluationResult) {
    definition "Post-production evaluation result"
    modality SHALL
    reference {
      ISO14971-doc-ref9
    }
  }
}

