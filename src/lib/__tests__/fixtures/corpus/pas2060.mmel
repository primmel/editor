exclusive_gateway NeutralityGateway {
  label "Has carbon neutrality been achieved?"
}

exclusive_gateway LagistrationGateway {
  label "Has legislation imposed any specific requirements on entities to use certain methodologies?"
}

exclusive_gateway MethodFromISOGatewat {
  label "No method exists"
}

exclusive_gateway RegionalMethodGateway {
  label "No method exists"
}

exclusive_gateway NoMethodGateway {
  label "No method exists"
}

exclusive_gateway SubjectChangeGateway {
  label "Any material change to the subject?"
}

exclusive_gateway SubjectIsOrganizationGateway {
  label "What is the nature of the subject?"
}

exclusive_gateway CalculationGateway {
  label "Is quantification based on calculations?"
}

exclusive_gateway GovernmentFactorAvailable {
  label "Are factors from national (Government) publications available"
}

exclusive_gateway RecurringEventGateway {
  label "Is the subject a non-recurring event such as a wedding or concert?"
}

exclusive_gateway RecurringEventActionGateway {
  label "Is the subject a recurring event?"
}

exclusive_gateway HistoricReductionGateway {
  label "Are historic reductions from the defined subject, not otherwise taken into account, to be taken into account?"
}

exclusive_gateway HistoricReductionActionGateWay {
  label "historic reductions are to be taken into account"
}

exclusive_gateway AlternativeMethodAvailableGateway {
  label "Does an alternative methodology become available that would
reduce uncertainty and yield more accurate, consistent and reproducible results?"
}

exclusive_gateway EGate1 {
}

exclusive_gateway SingleSourceDominanceGateway {
  label "Does a single source contribute more than 50% of the total emissions"
}

class Methodology#data {
  methodology {
    definition "Methodology used to deliver the evidence"
    modality SHALL
    reference {
      ref421
    }
  }
  justification {
    definition "Justification"
    modality SHALL
  }
}

class Achievement#data {
  declaration {
    definition "Declaration"
    modality SHALL
    reference {
      ref41
    }
  }
}

class CarbonFootprintPlan#data {
  commitment {
    definition "A statement of commitment to carbon neutrality for the defined subject"
    modality SHALL
    reference {
      ref41
      ref7
    }
  }
  timescale {
    definition "A timescale for achieving carbon neutrality of the defined subject"
    modality SHALL
    reference {
      ref7
    }
  }
  target {
    definition "Targets for GHG reduction for the defined subject appropriate to the timescale for achieving carbon neutrality"
    modality SHALL
    reference {
      ref7
    }
  }
  means {
    definition "Planned means of achieving and maintaining GHG emissions reductions "
    reference {
      ref7
    }
  }
  assumption {
    definition "Assumptions made of the techniques and measures to be employed to reduce GHG emissions
"
    modality SHALL
    reference {
      ref7
    }
  }
  justification {
    definition "Justification of the techniques and measures to be employed to reduce GHG emissions
"
    modality SHALL
    reference {
      ref7
    }
  }
  calculation {
    definition "Where historic reductions are to be taken into account, the period over which those reductions are to be calculated and confirmation that the necessary data is available and that calculation is to be undertaken using precisely the same methodology as that to be employed to assess and calculate future reductions"
    modality SHALL
    reference {
      ref7
    }
  }
  offset {
    definition "The offset strategy to be adopted including an estimate of the quantity of GHG emissions to be offset, the nature of the offsets and the likely number and type of credits"
    modality SHALL
    reference {
      ref7
    }
  }
}

