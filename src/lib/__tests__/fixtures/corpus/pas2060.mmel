class Reduction#data {
  type {
    definition "A statement identifying whether the reductions are overall, activity-based or intensity-based"
    modality SHALL
    reference {
      ref821
    }
  }
  reduction: GHGReduction {
    definition "GHG emissions that have been reduced"
    modality SHALL
    reference {
      ref821
    }
  }
  means {
    definition "Actual means of achieving GHG emissions reductions"
    modality SHALL
    reference {
      ref83
    }
  }
  confirmation {
    definition "Confirmation that the methodology used was applied in accordance with its provisions and that the principles set out in PAS 2060 clause 8.2.2"
    modality SHALL
    reference {
      ref83
    }
  }
  reductionMet {
    definition "Whether or not the actual reduction is in line with that forecast in the carbon management plan together"
    modality SHALL
    reference {
      ref83
    }
  }
  reason {
    definition "Reasons for any significant variation"
    modality SHALL
    reference {
      ref83
    }
  }
  footprint {
    definition "The size of the reduced carbon footprint"
    modality SHALL
    reference {
      ref83
    }
  }
}

