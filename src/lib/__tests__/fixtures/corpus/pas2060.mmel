  modality SHALL
  reference {
    ref912
  }
}

provision Provision92 {
  condition "Retire credits from carbon offset projects other than events within 12 months of the date of the declaration of achievement"
  modality SHALL
  reference {
    ref912
  }
}

provision Provision93 {
  condition "Retire credits from carbon offset projects for events as short as can be reasonably achieved"
  modality SHOULD
  reference {
