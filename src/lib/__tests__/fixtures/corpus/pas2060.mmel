root root

version "v1.0.0-dev1"

metadata {
  title "PAS 2060:2014 Specification for the demonstration of carbon neutrality"
  schema "MMEL 0.1"
  edition "2014"
  author "Ribose"
  shortname "PAS 2060"
  namespace "PAS2060Application"
}

role entity {
  name "Entity to demonstrate carbon neutrality "
}

role assessor {
  name "Assessing entity"
}

role Verifier {
  name "Independent third party verifier"
}

process DetermineSubject {
  name "Determine subject of carbon neutrality"
  actor entity
  modality SHALL
  validate_provision {
    Provision1
  }
  output {
    Subject
  }
  subprocess Page0
}

process QuantifyCarbon {
  name "Quantify carbon footprint"
  actor entity
  modality SHALL
  validate_provision {
    Provision0
    Provision51
  }
  subprocess Page1
}

process DevelopManagementPlan {
