  }
}

provision Provision12 {
  condition "Check for any applicable legislation"
  modality SHALL
  reference {
    ref421
  }
}

provision Provision13 {
  condition "Use methodologies imposed by legistration"
  modality SHALL
  reference {
    ref421
  }
}

provision Provision14 {
  condition "Document evidence used to substantiate declarations contained within PAS 2060"
  modality SHALL
  reference {
    ref422
  }
}

provision Provision15 {
  condition "Retain the documentation for the period that the status of carbon neutrality is valid, and for a period of six years thereafter."
  modality SHALL
  reference {
    ref422
  }
}

provision Provision16 {
  condition "Select methodologies used to deliver the evidence needed to substantiate the declarations contained within PAS 2060 following the order of preference"
  modality SHALL
  reference {
    ref421
  }
}

provision Provision18 {
  condition "Select methodologies from standards that have international acceptability (i.e. regional or national standards)"
  modality SHALL
  reference {
    ref421
  }
}

provision Provision17 {
  condition "Select methodologies from International Standards (ISO)"
  modality SHALL
  reference {
    ref421
  }
}

provision Provision19 {
  condition "Select methodologies from proprietary industry or trade methods that are considered to be sufficiently robust to demonstrate carbon neutrality in accordance with PAS 2060 in a manner that can be reliably and repeatedly validated"
  modality SHALL
  reference {
    ref421
  }
}

provision Provision20 {
  condition "Develop a method, provided it meets the principles and other requirements of PAS 2060, provides reliable and reproducible results and is freely available for peer review"
  modality MAY
  reference {
    ref421
  }
}

provision Provision22 {
  condition "Determine the length
of the application period to suit the requirements of the carbon footprint management plan"
  modality SHOULD
  reference {
    ref41
  }
}

provision Provision23 {
  condition "Determine application periods to be equal length other than where “historic reductions” are to be included in the first application period"
  modality SHOULD
  reference {
    ref41
  }
}

provision Provision24 {
  condition "The selection of particularly long application periods (e.g. in excess of two years) can delay recognition of the assessing entities' achievement"
  reference {
    ref41
  }
}

provision Provision25 {
  condition "Take into consideration GHG emission reductions associated with the defined subject immediately prior to the baseline date (historic reductions) to enable declarations of neutrality."
  modality MAY
  reference {
    ref41
  }
}

provision Provision21 {
  condition "Declare Achievement for Baseline Period based on any reduction achieved during the period plus permitted historic reduction and offset or based on 100% offset"
  modality SHOULD
  reference {
    ref41
  }
}

provision Provision26 {
  condition "Make a Declaration of Achievement of carbon neutrality at the end of the first application period and it can be based on reductions achieved during the first application period together with reductions achieved during a specified continuous period immediately prior to the baseline date"
  modality CAN
  reference {
    ref41
  }
}

provision Provision27 {
  condition "Use offsetting to account for all of the GHG emissions associated with the defined subject at the end of the first application period and are therefore able to make a Declaration of Achievement of carbon neutrality at the end of the first application period based solely on offsetting"
  modality MAY
  reference {
    ref41
  }
}

provision Provision29 {
  condition "Establish and take into consideration all activities material to the fulfilment, achievement or delivery of the purposes, objectives or functionality of the subject"
  modality SHALL
  reference {
    ref511
  }
}

provision Provision30 {
  condition "Ensure that the definition of the subject remains unchanged through each and every stage of the methodology set out"
  reference {
    ref512
  }
}

provision Provision31 {
  condition "Re-start the sequence on the basis of a newly-defined subject."
  modality SHALL
  reference {
    ref512
  }
}

provision Provision34 {
  condition "Define boundaries to be a true and fair representation of the organization's GHG emissions (i.e. shall include all GHG emissions relating to core operations including subsidiaries owned and operated by the organization)"
  modality SHALL
  reference {
    ref522
  }
}

provision Provision35 {
  condition "Use the equity share or control approach to define which GHG emissions are to be included"
  modality SHALL
  reference {
    ref522
  }
}

provision Provision36 {
  condition "Identify subject that is part of an organization or a specific site or location, and treat it as a discrete operation with its own purpose, objectives and functionality"
  modality SHALL
  reference {
    ref522
  }
}

provision Provision37 {
  condition "Ensure claims are credible, so if an entity chooses a very narrow subject and excludes its carbon intensive activities or if it outsources its carbon intensive activities, then this needs to be documented"
  modality SHALL
  reference {
    ref522
  }
}

provision Provision38 {
  condition "Under the equity share approach, accounts for GHG emissions from the subject according to its share of equity in the subject"
  modality SHALL
  reference {
    ref522
  }
}

provision Provision39 {
  condition "Under the control approach, accounts for 100% of the GHG emissions over which it has financial and/or operational control.
"
  modality SHALL
  reference {
    ref522
  }
}

provision Provision28 {
  condition "Determination the subject"
  modality SHALL
  reference {
    ref511
  }
}

provision Provision32 {
  condition "Select subject based on a broader understanding of the entire carbon footprint of the entity so that the carbon footprint of the selected subject can be seen in context"
  modality SHOULD
  reference {
    ref521
  }
}

provision Provision33 {
  condition "Be able to demonstrate that they are not intentionally excluding their most significant GHG emissions (or alternatively can justify why they have done so)"
  modality SHOULD
  reference {
    ref521
  }
}

provision Provision41 {
  condition "Include all greenhouse gases and convert into tCO_2e"
  modality SHALL
  reference {
