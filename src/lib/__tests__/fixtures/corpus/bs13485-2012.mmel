class QualityManual#data {
  scope {
    definition "Scope of the quality management system, including details of and justification for any exclusion or non-application"
    modality SHALL
    reference {
      ref4-2-2
    }
  }
  procedure {
    definition "Documented procedures for the quality management system, or reference to them"
    modality SHALL
    reference {
      ref4-2-1
    }
  }
  interaction {
    definition "Description of the interaction between the processes of the quality management system"
    modality SHALL
    reference {
      ref4-2-1
    }
  }
}

