measurement implant {
  type TRUE/FALSE
  description "There is implantable medical device"
}

measurement outsourcing {
  type TRUE/FALSE
  definition "disableda"
  description "There is outsourcing"
}

measurement sterile {
  type TRUE/FALSE
  description "There is sterile medical device"
}

measurement customerreq {
  type TRUE/FALSE
  description "Customer provides documented statement of requirement"
}

measurement connected {
  type TRUE/FALSE
  description "The intended use requires that the medical device be connected to, or have an interface with, other medical device(s)"
}

measurement cleanliness {
  type TRUE/FALSE
  description "The cleanliness of product is required"
}

measurement external_install {
  type TRUE/FALSE
  description "The device can be installed by external parties"
}

measurement servicing {
  type TRUE/FALSE
  description "Servicing of the medical device is required"
}

measurement identification {
  type TRUE/FALSE
  description "Identification is required"
}

measurement customer_property {
  type TRUE/FALSE
  description "There is customer property"
}

measurement protection {
  type TRUE/FALSE
  description "Packaging alone can provide preservation"
}

measurement calibration {
  type TRUE/FALSE
  description "International or national standards exist for calibration"
}

measurement review {
  type TRUE/FALSE
  description "Post-production review is required by regulatory requirements"
}

measurement reporting {
  type TRUE/FALSE
  description "Notification of complaints is required by applicable regulatory requirements"
}

note Note1 {
  type NOTE
  message "Roles undertaken by the organization can include manufacturer, authorized representative, importer or distributor"
  reference {
    ref4-1-1
  }
}

note Note2 {
  type NOTE
  message "The methodology used to check effectiveness is proportionate to the risk associated with the work for which the training or other action is being provided"
  reference {
    ref6-2
  }
}

note Note3 {
  type NOTE
  message "Further information can be found in ISO 14644 and ISO 14698"
  reference {
    ref6-4-1
  }
}

note Note4 {
  type NOTE
  message "Further information can be found in ISO 14971"
  reference {
    ref7-1
  }
}

note Note5 {
  type NOTE
  message "Further information can be found in IEC 62366–1"
  reference {
    ref7-3-3
  }
}

note Note6 {
  type NOTE
  message "Further information can be found in ISO 11607-1 and ISO 11607-2"
  reference {
    ref7-5-7
  }
}

note Note7 {
  type NOTE
  message "Further information can be found in ISO 10012"
}

note Note8 {
  type NOTE
  message "Further information can be found in ISO 19011"
  reference {
    ref8-2-4
  }
}

view uk {
  name "UK"
  variables {
    identification {
      required true
      value "true"
    }
    review {
      required true
      value "true"
    }
    reporting {
      required true
      value "true"
    }
  }
}

view us {
  name "US"
  variables {
    identification {
      required false
      value "false"
    }
    review {
      required false
      value "false"
    }
    reporting {
      required false
      value "false"
    }
  }
}

view fr {
  name "FR"
  variables {
    review {
      required true
      value "true"
    }
  }
}

