}

role Org {
  name "Organization"
}

role ProductTeam {
  name "R&D Department"
}

role Production {
  name "Production Department"
}

role Testing {
  name "Testing department"
}

role ManagementCommittee {
  name "Management Committee"
}

role TopMan {
  name "Top Management"
}

start_event Start1 {
}

class RiskPlan#data {
  scope {
    definition "Scope"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
  Assignment {
    definition "Responsibilities and authorities"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
  Requirements {
    definition "Requirements for review of risk management activities"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
  Criteria {
    definition "Criteria for risk acceptability"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
  Verification {
    definition "Verification activities"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
  activities {
    definition "Collection and review of relevant production and post-production information"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
}

data_registry RiskPlan {
  title "Risk management plan"
  data_class RiskPlan#data
}

class ChangeRecord#data {
  Subject {
    definition "Subject of change"
  }
  Date {
    definition "Date of change"
  }
  Reason {
    definition "Reason of change"
  }
  Approval {
    definition "Approval information"
  }
}

data_registry ChangeRecord {
  title "Change record"
  data_class ChangeRecord#data
}

class RiskAnalysisRecord#data {
  implementation {
    definition "Methodology of risk analysis"
    modality SHALL
    reference {
      ISO14971-doc-ref4-1
    }
  }
  results {
    definition "Results of the risk analysis"
    modality SHALL
    reference {
      ISO14971-doc-ref4-1
    }
  }
  medicalDevice {
    definition "Medical device that was analysed"
    modality SHALL
    reference {
      ISO14971-doc-ref4-1
    }
  }
  Person {
    definition "Person who carried out the risk analysis"
    modality SHALL
    reference {
      ISO14971-doc-ref4-1
    }
  }
  Scope {
    definition "Scope of the risk analysis"
    modality SHALL
    reference {
      ISO14971-doc-ref4-1
    }
  }
  Date {
    definition "Date of risk analysis"
  }
  ID {
    definition "Risk ID"
  }
}

data_registry RiskAnalysisRecord {
  title "Risk analysis records"
  data_class RiskAnalysisRecord#data
}

class MedicalDevice#data {
  use {
    definition "Intended use"
  }
  specification {
    definition "Specification"
  }
}

data_registry MedicalDevice {
  title "Medical device characteristics"
  data_class MedicalDevice#data
}

class Hazards#data {
  hazard {
    definition "Known hazards"
  }
  hazard2 {
    definition "Foreseeable hazards"
  }
  type: HazardType {
    definition "Hazard type"
  }
}

data_registry Hazards {
  title "Hazards"
  data_class Hazards#data
}

class RiskEvaluationResult#data {
  riskEvaluated {
    definition "Risk evaluated"
  }
  result {
    definition "Evaluation results"
  }
}

data_registry RiskEvaluationResult {
  title "Risk evaluation results"
  data_class RiskEvaluationResult#data
}

class RiskControlRecord#data {
  selected {
    definition "risk control measures selected"
    modality SHALL
    reference {
      ISO14971-doc-ref6-2
    }
  }
  implementation {
    definition "verification of implementation of each risk control measure"
    modality SHALL
    reference {
      ISO14971-doc-ref6-3
    }
  }
  effectiveness {
    definition "verification of the effectiveness of the risk control measure"
    modality SHALL
    reference {
      ISO14971-doc-ref6-3
    }
  }
  residualRisk {
    definition "residual risk shall be evaluated"
    modality SHALL
    reference {
      ISO14971-doc-ref6-4
    }
  }
  risk/benefit {
    definition "results of risk/benefit analysis"
    modality SHALL
    reference {
      ISO14971-doc-ref6-5
    }
  }
}

data_registry RiskControlRecord {
  title "Risk control records"
  data_class RiskControlRecord#data
}

class RiskControlMeasureReview#data {
}

data_registry RiskControlMeasureReview {
  title "Risk control measure review"
  data_class RiskControlMeasureReview#data
}

class Post-ProductionEvaluationResult#data {
}

data_registry Post-ProductionEvaluationResult {
  title "Post-production evaluation result"
  data_class Post-ProductionEvaluationResult#data
}

class RiskManagementFile#data {
  plan: reference(RiskPlan) {
    definition "Risk Management Plan"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
  change: reference(ChangeRecord) {
    definition "Record of changes"
    modality SHALL
    reference {
      ISO14971-doc-ref3-4
    }
  }
  analysis: reference(RiskAnalysisRecord) {
    definition "Risk analysis"
    modality SHALL
    reference {
      ISO14971-doc-ref4-1
    }
  }
  device: reference(MedicalDevice) {
    definition "characteristics related to the safety of the medical device"
    modality SHALL
    reference {
      ISO14971-doc-ref4-2
    }
  }
  hazards: reference(Hazards) {
    definition "Known and foreseeable hazards associated with the medical device in both normal and fault conditions"
    modality SHALL
  }
  evaluation: reference(RiskEvaluationResult) {
    definition "Risk evaluation results"
    modality SHALL
    reference {
      ISO14971-doc-ref5
    }
  }
  control: reference(RiskControlRecord) {
    definition "Risk control records"
    modality SHALL
    reference {
      ISO14971-doc-ref6-2
    }
  }
  review: reference(RiskControlMeasureReview) {
    definition "Result of risk control measure review"
    modality SHALL
    reference {
      ISO14971-doc-ref6-6
    }
  }
  post-productionEvaluation: reference(Post-ProductionEvaluationResult) {
    definition "Post-production evaluation result"
    modality SHALL
    reference {
      ISO14971-doc-ref9
    }
  }
}

data_registry RiskManagementFile {
  title "Risk management file"
  data_class RiskManagementFile#data
}

process RiskManagementFile1 {
  name "Manage Risk management file"
  actor Org
  validate_provision {
    Provision1
  }
  note {
    Note1
    Note2
  }
  output {
    RiskManagementFile
  }
}

class Procedure#data {
  Process {
    definition "Processes"
  }
  Procedures {
    definition "Procedures"
  }
}

data_registry Procedure {
  title "QMS Manual"
  data_class Procedure#data
}

class Requirement#data {
}

data_registry Requirement {
  title "Requirement"
  data_class Requirement#data
}

process DocumentQMS {
  name "Quality management system"
  actor Org
  validate_provision {
    Provision2
    Provision3
    Provision4
  }
  output {
    Procedure
  }
  subprocess Page1
}

start_event Start2 {
}

process Process1 {
  name "Establish management committee"
  actor TopMan
}

process Process2 {
  name "Quality Policy"
}

class QualityPolicy#data {
  content {
    definition "Quality Policy Content"
  }
}

data_registry QualityPolicy {
  title "Quality Policy"
  data_class QualityPolicy#data
}

process DocumentQualityPolicy {
  name "Establish Quality Policy"
  actor Org
  output {
    QualityPolicy
  }
}

approval Approval1 {
  name "Approve quality policy statement"
  modality SHALL
  approve_by ManagementCommittee
}

process Process3 {
  name "Internal Audit"
  actor Org
}

process Process4 {
  name "Resources management"
  actor Org
}

process Process5 {
  name "Product Realization"
  actor Org
  subprocess Page2
}

start_event Start3 {
}

process Process6 {
  name "Product planning"
  actor ProductTeam
}

process Process7 {
  name "Product design and development"
  actor ProductTeam
}

process Process8 {
  name "Product verfiication and validation"
  actor ProductTeam
}

process Process9 {
  name "Product launch"
  actor Production
}

process Process10 {
  name "Monitoring"
  actor Testing
}

process DetermineObjectiveForProduct {
  name "Establish quality objectives"
  actor ManagementCommittee
  validate_provision {
    Provision5
  }
}

provision Provision1 {
  condition "For the particular medical device being considered, the manufacturer shall establish and maintain a risk management file"
  modality SHALL
  reference {
    ISO14971-doc-ref3-5
  }
}

provision Provision2 {
  condition "Document a quality management system"
  modality SHALL
  reference {
    ref4-1-1
  }
}

provision Provision3 {
  condition "Maintain its effectiveness in accordance with the requirements of ISO 13485 and applicable regulatory requirements"
  modality SHALL
  reference {
    ref4-1-1
  }
}

provision Provision4 {
  condition "Establish and maintain records needed to demonstrate conformance to ISO 13485  and compliance with applicable regulatory requirements"
  modality SHALL
  reference {
    ref4-1-3
  }
}

provision Provision5 {
  condition "Determine quality objectives and requirements for the product"
  modality SHALL
  reference {
    ref7-1
  }
}

enum HazardType {
  Physical {
    definition "Physical"
  }
  Chemical {
    definition "Chemical"
  }
  Biological {
    definition "Biological"
  }
}

