  }
}

provision Provision72 {
  condition "The completed flat cable or multi-core circular cable shall be tested in accordance with BS EN 50395 , 10.3, having either a test voltage of 2 000 V a.c. r.m.s. for 5 minutes and there shall be no breakdown of the insulation"
  modality SHALL
  reference {
    BS6004:2012-ref14-3-2
  }
}

provision Provision73 {
  condition "The completed flat cable or multi-core circular cable shall be tested in accordance with BS EN 50395 , 10.3, having 5000 V d.c. for 5 minutes and there shall be no breakdown of the insulation."
  modality SHALL
  reference {
    BS6004:2012-ref14-3-2
  }
}

provision Provision74 {
  condition "Single-core flat cable, with an uninsulated circuit protective conductor (6241Y) shall have the test voltage applied to the core, and the uninsulated circuit protective conductor shall be earthed"
  modality SHALL
  reference {
    BS6004:2012-ref14-3-2
  }
}

provision Provision75 {
  condition "Sample tests shall be performed in accordance with Table 2 as indicated by the symbol “S” in column 4"
  modality SHALL
  reference {
    BS6004:2012-ref15-1
  }
}

provision Provision83 {
  condition "When tested in accordance with Annex E , no breakdown of the insulation shall occur"
  modality SHALL
  reference {
    BS6004:2012-ref15-4
  }
}

provision Provision84 {
  condition "The length of lay shall be determined by measuring the length of two pitches of a laid up assembly taken from a sample of cable and calculating the average of these two lengths"
  modality SHALL
  reference {
    BS6004:2012-ref15-5
  }
}

provision Provision85 {
  condition "The result shall be taken as the length of lay of the laid-up cores"
  modality SHALL
  reference {
    BS6004:2012-ref15-5
  }
}

provision Provision86 {
  condition "Type tests shall be performed in accordance with Table 2 as indicated by the symbol “T” in column 4"
  modality SHALL
  reference {
    BS6004:2012-ref16-1
  }
}

provision Provision94 {
  condition "Period of immersion in water: minimum 1 h"
  modality SHALL
  reference {
    BS6004:2012-ref16-3
  }
}

provision Provision95 {
  condition "Temperature of the water: (20 ±5) °C"
  modality SHALL
  reference {
    BS6004:2012-ref16-3
  }
}

provision Provision96 {
  condition "Applied voltage (a.c.) according to the tabulated thickness of insulation"
  modality SHALL
  reference {
    BS6004:2012-ref16-3
  }
}

provision Provision97 {
  condition "Applied voltage (a.c.): 2000V"
  modality SHALL
  reference {
    BS6004:2012-ref16-3
  }
}

provision Provision98 {
  condition "Applied voltage: 1500V"
  modality SHALL
  reference {
    BS6004:2012-ref16-3
  }
}

provision Provision99 {
  condition "Duration of each application of voltage: minimum 5 min"
  modality SHALL
  reference {
    BS6004:2012-ref16-3
  }
}

provision Provision100 {
  condition "There shall be no breakdown of the insulation"
  modality SHALL
  reference {
    BS6004:2012-ref16-3
  }
}

provision Provision102 {
  condition "Temperature of the aqueous solution: (60 ±5) °C"
  modality SHALL
  reference {
    BS6004:2012-ref16-4
  }
}

provision Provision103 {
  condition "Applied voltage (d.c.): 220 V"
  modality SHALL
  reference {
    BS6004:2012-ref16-4
  }
}

provision Provision104 {
  condition "Period of immersion in the aqueous solution, and duration of application of voltage: minimum 240 h"
  modality SHALL
  reference {
    BS6004:2012-ref16-4
  }
}

provision Provision105 {
  condition "The insulation shall not break down nor shall the exterior of the insulation show damage"
  modality SHALL
  reference {
    BS6004:2012-ref16-4
  }
}

provision Provision106 {
  condition "Discoloration of the insulation shall be ignored"
  modality SHALL
  reference {
    BS6004:2012-ref16-4
  }
}

provision Provision107 {
  condition "When a sample of complete cable is aged in accordance with D.2 , the insulation and the outer sheath shall conform to the requirements given in Table D.1"
  modality SHALL
  reference {
    BS6004:2012-ref16-5
  }
}

provision Provision108 {
  condition "At the end of the test period in the oven, the blotting paper shall be free of stains"
  modality SHALL
  reference {
    BS6004:2012-ref16-5
  }
}

provision Provision111 {
  condition "During the test of 30 000 cycles, i.e. 60 000 single movements, there shall be no interruption of the current"
  modality SHALL
  reference {
    BS6004:2012-ref16-7
  }
}

provision Provision112 {
  condition "During the test of 30 000 cycles, i.e. 60 000 single movements, there shall be no short circuit between the conductors"
  modality SHALL
  reference {
    BS6004:2012-ref16-7
  }
}

provision Provision113 {
  condition "During the test of 30 000 cycles, i.e. 60 000 single movements, there shall be no short circuit between the cable and the pulley wheels (the flexing apparatus)"
  modality SHALL
  reference {
    BS6004:2012-ref16-7
  }
}

provision Provision114 {
  condition "After the required number of cycles the sheath shall be examined under normal or corrected vision"
  modality SHALL
  reference {
    BS6004:2012-ref16-7
  }
}

provision Provision115 {
  condition "There shall be no point at which any underlying component of the cable (for instance tapes, insulated cores, etc.) shall be visible through a break in the sheath"
  modality SHALL
  reference {
    BS6004:2012-ref16-7
  }
}

provision Provision116 {
  condition "The sheath of the cable shall then be removed"
  modality SHALL
  reference {
    BS6004:2012-ref16-7
  }
}

provision Provision117 {
  condition "The cores from the cable, without its sheath, shall be tested in accordance with 16.3 and there shall be no breakdown of the insulation"
  modality SHALL
  reference {
    BS6004:2012-ref16-7
  }
}

provision Provision17 {
  condition "The cores of all cables shall be identified by colour."
  modality SHALL
  reference {
    BS6004:2012-ref8-1
  }
}

provision Provision18 {
  condition "Each core shall be identified by its colour as indicated in Table 3 to Table 6"
  modality SHALL
  reference {
    BS6004:2012-ref8-1
  }
}

provision Provision23 {
  condition "The colours of the cores, determined by the number of cores in the cable, and also the sequence of the colours shall be as given in Table 3 to Table 6"
  modality SHALL
  reference {
    BS6004:2012-ref8-2
  }
}

provision Provision6 {
  condition "The maximum permanent permitted operating voltage of the system for conductor-earth (a.c.) shall be 320V"
  modality SHALL
  reference {
    BS6004:2012-ref4
  }
}

provision Provision7 {
  condition "The maximum permanent permitted operating voltage of the system for conductor-conductor (a.c.) shall be 550V"
  modality SHALL
}

provision Provision8 {
  condition "The maximum permanent permitted operating voltage of the system for conductor-earth (d.c.) shall be 410V"
  modality SHALL
}

provision Provision9 {
  condition "The maximum permanent permitted operating voltage of the system for conductor-conductor (d.c.) shall be 820V"
  modality SHALL
}

provision Provision78 {
  condition "For circular cables, the mean of the six values obtained shall be taken as the mean overall diameter"
  modality SHALL
  reference {
    BS6004:2012-ref15-2
  }
}

provision Provision79 {
  condition "For flat cables, the mean of each set of three values, for the major and minor axis, respectively, shall be taken as the relevant overall dimension"
  modality SHALL
  reference {
    BS6004:2012-ref15-2
  }
}

provision Provision88 {
  condition "Period of immersion in water: minimum 2h"
  modality SHALL
  reference {
    BS6004:2012-ref16-2
  }
}

provision Provision89 {
  condition "Temperature of water for cables in Tables 3, 4 and 5 : (70 ±2) °C"
  modality SHALL
  reference {
    BS6004:2012-ref16-2
  }
}

provision Provision90 {
  condition "Temperature of water for cables in Tables 3, 4 and 5 : (70 ±2) °C"
  modality SHALL
  reference {
    BS6004:2012-ref16-2
  }
}

provision Provision91 {
  condition "Temperature of water for cables in Table 6 : (60 ±2) °C"
  modality SHALL
  reference {
    BS6004:2012-ref16-2
  }
}

provision Provision92 {
  condition "None of the resulting values shall be below the minimum insulation resistance value specified in Table 3 to Table 6"
  modality SHALL
  reference {
    BS6004:2012-ref16-2
  }
}

provision Provision4 {
  condition "The construction of the cables shall be as specified in Table 3 to Table 6"
  modality SHALL
  reference {
    BS6004:2012-ref5
  }
}

provision Provision1 {
  condition "The cables shall be designated by the rated voltages U_0 and U , expressed in the form U_0 / U"
  modality SHALL
  reference {
    BS6004:2012-ref4
  }
}

provision Provision2 {
  condition "The rated voltage recognized for the purpose of this British Standard shall be 300/500 V"
  modality SHALL
  reference {
    BS6004:2012-ref4
  }
}

provision Provision3 {
  condition "The maximum permanent permitted operating voltages of the system shall be in accordance with Table 1"
  modality SHALL
  reference {
    BS6004:2012-ref4
  }
}

provision Provision5 {
  condition "The conductors shall be annealed copper conforming to BS EN 60228"
  modality SHALL
  reference {
    BS6004:2012-ref6
  }
}

provision Provision10 {
  condition "The class of conductor shall be as given in Table 3 to Table 6"
  modality SHALL
  reference {
    BS6004:2012-ref6
  }
}

provision Provision12 {
  condition "The insulation shall be applied by an extrusion process to form a compact and homogeneous layer."
  modality SHALL
  reference {
    BS6004:2012-ref7-2
  }
}

provision Provision13 {
  condition "Where more than one layer is used, all testing specified in this British Standard shall be carried out on the complete insulation as though it were a single layer of the declared insulation type (see 7.1 )"
  modality SHALL
  reference {
    BS6004:2012-ref7-2
  }
}

provision Provision14 {
  condition "When the application is tested by removing the insulation from the conductor, there shall be no damage to the insulation itself or the conductor"
  modality SHALL
  reference {
    BS6004:2012-ref7-2
  }
}

provision Provision11 {
  condition "The insulation shall be one of the following types, in accordance with Table 3 to Table 6:
• TI 1 as specified in BS EN 50363‑3 ;
• TI 4 as specified in BS EN 50363‑3 ."
  modality SHALL
  reference {
    BS6004:2012-ref7-1
  }
}

provision Provision15 {
  condition "The mean value of the radial thickness of the insulation, when measured in accordance with BS EN 50396 , 4.1 , shall be not less than the value given in Table 3 to Table 6"
  modality SHALL
  reference {
    BS6004:2012-ref7-3
  }
}

provision Provision16 {
  condition "The smallest value measured, t_m , shall not fall below 90% of the value given in Table 3 to Table 6 by more than 0.1 mm, i.e.: t_m >= 0.9 t_n - 0.1 where t_m is the smallest value measured, in millimetres (mm); and t_n is the tabulated radial thickness, in millimetres (mm)"
  modality SHALL
  reference {
    BS6004:2012-ref7-3
  }
}

provision Provision25 {
  condition "On a core with the bi-colour combination of green-and-yellow, the distribution of these colours shall be such that for every 15 mm length of core one of these colours shall cover not less than 30% and not more than 70% of the surface of the core, while the other colour shall cover the remainder of the surface"
  modality SHALL
  reference {
    BS6004:2012-ref8-2
  }
}

provision Provision26 {
  condition "The colour used for core identification shall be clearly identifiable and durable such that it cannot be removed when tested in accordance with BS EN 50396 , 5.1"
  modality SHALL
  reference {
    BS6004:2012-ref8-3
  }
}

provision Provision32 {
  condition "The sheath shall be an extruded layer of PVC of one of the following types, in accordance with Table 3 to Table 6 :
• Type 6 as specified in BS 7655‑4.2.
• Type 10 as specified in BS 7655‑4.2."
  modality SHALL
  reference {
    BS6004:2012-ref10-1
  }
}

provision Provision36 {
  condition "When measured in accordance with BS EN 50396 , 4.2 or 4.3 , as applicable, the smallest value, t_m , of the radial thickness of the sheath shall not fall below 85% of the value given in Table 3 to Table 6 by more than 0.1 mm, i.e.: t_m >= 0.85t_n - 0.1
where t_m is the smallest value measured, in millimetres (mm); and t_n is the tabulated radial thickness, in millimetres (mm)"
  modality SHALL
  reference {
    BS6004:2012-ref10-3
  }
}

provision Provision62 {
  condition "Where the information is applied by printing, it shall be durable so that it cannot be removed when tested in accordance with BS EN 50396 , 5.1"
  modality SHALL
  reference {
    BS6004:2012-ref11-4
  }
}

provision Provision63 {
  condition "The tests to be performed on cables specified in this British Standard shall be as specified in Table 2 , which refers to the relevant clauses of the standard specifying the requirements and test methods as well as the category of each test which applies, i.e. T, S or R (as defined in Clause 3 )"
  modality SHALL
  reference {
    BS6004:2012-ref12
  }
}

provision Provision68 {
  condition "The d.c. resistance of each conductor shall conform to BS EN 60228 when measured in accordance with BS EN 60228 , Annex A, and corrected to 20 °C."
  modality SHALL
  reference {
    BS6004:2012-ref14-2
  }
}

provision Provision69 {
  condition "The measurement shall be made on a complete drum length or on a 1 m sample taken from the drum"
  modality SHALL
  reference {
    BS6004:2012-ref14-2
  }
}

provision Provision70 {
  condition "The completed single-core circular cable shall be tested in accordance with the a.c. or d.c. test method in BS EN 62230 at the test voltage stated in BS 5099 , 5.3 , (insulation and sheath combined) and there shall be no breakdown of the insulation or sheath."
  modality SHALL
  reference {
    BS6004:2012-ref14-3-1
  }
}

provision Provision71 {
  condition "The completed flat cable or multi-core circular cable shall be tested in accordance with BS EN 50395 , 10.3 , having either a test voltage of 2 000 V a.c. r.m.s. or 5 000 V d.c., for 5 minutes and there shall be no breakdown of the insulation"
  modality SHALL
  reference {
    BS6004:2012-ref14-3-2
  }
}

provision Provision76 {
  condition "When tested in accordance with BS EN 50396 , 4.4 , the mean overall diameter of circular cables and the mean overall dimensions of flat cables shall be within the limits specified in Table 3 to Table 6"
  modality SHALL
  reference {
    BS6004:2012-ref15-2
  }
}

provision Provision77 {
  condition "A test sample shall be taken from a cable from three places, separated by not less than 1 m"
  modality SHALL
  reference {
    BS6004:2012-ref15-2
  }
}

provision Provision80 {
  condition "The difference between any two values of the overall diameter of circular sheathed cables at the same cross-section shall not exceed 15% of the upper limit for the mean overall diameter given in Table 3 and Table 6 when tested in accordance with BS EN 50396 , 4.4"
  modality SHALL
  reference {
    BS6004:2012-ref15-3
  }
}

provision Provision81 {
  condition "A test sample shall be taken from a cable from three places, separated by not less than 1 m"
  modality SHALL
  reference {
    BS6004:2012-ref15-3
  }
}

provision Provision82 {
  condition "Two measurements shall be taken at the same cross-section of the cable, covering the maximum and minimum values"
  modality SHALL
  reference {
    BS6004:2012-ref15-3
  }
}

provision Provision87 {
  condition "The cores are tested in accordance with BS EN 50395 , 8.1, under the conditions specified inside this subprocess"
  modality SHALL
  reference {
    BS6004:2012-ref16-2
  }
}

provision Provision93 {
  condition "The cores are tested in accordance with BS EN 50395 , Clause 7 under the conditions specified in this subprocess"
  modality SHALL
  reference {
    BS6004:2012-ref16-3
  }
}

provision Provision101 {
  condition "The cable is tested in accordance with BS EN 50395 , Clause 9, under the test conditions specified in this subprocess"
  modality SHALL
  reference {
    BS6004:2012-ref16-4
  }
}

provision Provision109 {
  condition "When tested in accordance with BS EN 60332‑1‑2 , the completed cable shall conform to BS EN 60332‑1‑2:2004 , Annex A"
  modality SHALL
  reference {
    BS6004:2012-ref16-6
  }
}

provision Provision110 {
  condition "The cables in Table 6 shall be tested in accordance with BS EN 50396 , 6.2 , and BS EN 50395 , Clause 7 , and shall conform to the requirements in this subprocess"
  modality SHALL
  reference {
    BS6004:2012-ref16-7
  }
}

provision Provision49 {
  condition "The marking of the elements shall be by embossing or indenting on the sheath"
  modality SHALL
  reference {
    BS6004:2012-ref11-1
  }
}

provision Provision50 {
  condition "The markings shall appear along the axis of the cable in any sequence that is deemed to neither confuse nor conflict"
