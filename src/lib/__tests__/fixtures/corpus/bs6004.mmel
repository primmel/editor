subprocess Page1 {
  elements {
    Start2 {
      x 30
      y -20
    }
    RatedVoltageEarthAC {
      x -250
      y 350
    }
    RatedVoltageConductorAC {
      x -100
      y 350
    }
    RatedVoltageEarthDC {
      x 50
      y 350
    }
    RatedVoltageConductorDC {
      x 200
      y 350
    }
    DCGateway {
      x 30
      y 80
    }
    DCEarthGateway {
      x 180
      y 209.99999999999997
    }
    ACEarthGateway {
      x -120
      y 210
    }
  }
  process_flow {
    Edge1 {
      from Start2
      to DCGateway
    }
    Edge2 {
      from DCGateway
      to ACEarthGateway
      description "No"
      condition "default"
    }
    Edge3 {
      from DCGateway
      to DCEarthGateway
      description "Yes"
      condition "[dc] = 'true'"
    }
    Edge4 {
      from ACEarthGateway
      to RatedVoltageEarthAC
      description "Yes"
      condition "[target] = 'true'"
    }
    Edge5 {
      from ACEarthGateway
      to RatedVoltageConductorAC
      description "No"
      condition "default"
    }
    Edge6 {
      from DCEarthGateway
      to RatedVoltageEarthDC
      description "Yes"
      condition "[target] = 'true'"
    }
    Edge7 {
      from DCEarthGateway
      to RatedVoltageConductorDC
      description "No"
      condition "default"
    }
  }
  data {
  }
}

subprocess Page2 {
