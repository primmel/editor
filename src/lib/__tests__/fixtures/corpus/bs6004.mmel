provision Provision22 {
  condition "Conformity shall be checked by measurement"
  modality SHALL
  reference {
    BS6004:2012-ref8-2
  }
}

provision Provision19 {
  condition "The colour shall be applied throughout either the whole insulation or the outer cohesive layer"
  modality SHALL
  reference {
    BS6004:2012-ref8-2
  }
}

provision Provision20 {
  condition "The colour shall be applied as part of the extrusion process"
  modality SHALL
  reference {
    BS6004:2012-ref8-2
  }
}

provision Provision21 {
  condition "The insulation of the coloured cores, irrespective of the method of colouring, shall be tested as a complete single layer (see 7.2 )"
  modality SHALL
  reference {
    BS6004:2012-ref8-2
  }
}

provision Provision27 {
  condition "The cores of the 2-core, 3-core, 4-core and 5-core circular cables shall be laid up together"
  modality SHALL
  reference {
    BS6004:2012-ref9
  }
}

provision Provision24 {
  condition "Where alternative colours are used (see 8.1 , Note), the sequence shall be agreed with the manufacturer"
  modality SHALL
  reference {
    BS6004:2012-ref8-2
  }
}

provision Provision28 {
  condition "Cores shall be laid up in the sequence of colours as given in Table 6"
  modality SHALL
  reference {
    BS6004:2012-ref9
  }
}

provision Provision29 {
  condition "Conformity shall be checked by visual examination"
  modality SHALL
  reference {
    BS6004:2012-ref9
  }
}

provision Provision30 {
  condition "The maximum length of lay for circular cables shall be not more than 25 times the diameter of the assembly of laid up cores"
  modality SHALL
  reference {
    BS6004:2012-ref9
  }
}

provision Provision31 {
  condition "Conformity shall be checked in accordance with 15.5"
  modality SHALL
  reference {
    BS6004:2012-ref9
  }
}

provision Provision37 {
  condition "The colour shall be applied throughout either the whole sheath or the outer cohesive layer and shall be applied as part of the extrusion process"
  modality SHALL
  reference {
    BS6004:2012-ref10-4
  }
}

provision Provision38 {
  condition "The sheath, irrespective of the method of colouring, shall be tested as a complete single layer (see 10.2 )"
  modality SHALL
  reference {
    BS6004:2012-ref10-4
  }
}

provision Provision39 {
  condition "The colour of the sheath shall be as specified in Table 3 to Table 6"
  modality SHALL
  reference {
    BS6004:2012-ref10-4
  }
}

provision Provision40 {
  condition "The external surface of all cables conforming to this British Standard shall be legibly marked with the elements given inside this process"
  modality SHALL
  reference {
    BS6004:2012-ref11-1
  }
}

provision Provision33 {
  condition "The sheath shall be applied by an extrusion process"
  modality SHALL
  reference {
    BS6004:2012-ref10-2
  }
}

provision Provision34 {
  condition "Where more than one layer is used, all testing specified in this British Standard shall be carried out on the complete sheath as though it were a single layer of the declared sheath type (see 10.1 )"
  modality SHALL
  reference {
    BS6004:2012-ref10-2
  }
}

provision Provision35 {
  condition "When the sheath is removed, there shall be no damage to the core insulation when visually checked"
  modality SHALL
  reference {
    BS6004:2012-ref10-2
  }
}

provision Provision43 {
  condition "The external surface of all cables conforming to this British Standard shall be legibly marked with voltage designation"
  modality SHALL
  reference {
    BS6004:2012-ref11-1
  }
}

provision Provision42 {
  condition "The external surface of all cables conforming to this British Standard shall be legibly marked with ELECTRIC CABLE"
  modality SHALL
  reference {
    BS6004:2012-ref11-1
  }
}

provision Provision41 {
  condition "The external surface of all cables conforming to this British Standard shall be legibly marked with cable manufacturer"
  modality SHALL
  reference {
    BS6004:2012-ref11-1
  }
}

provision Provision44 {
  condition "The external surface of all cables conforming to this British Standard shall be legibly marked with British Standard number "
  modality SHALL
  reference {
    BS6004:2012-ref11-1
  }
}

provision Provision45 {
  condition "The external surface of all cables conforming to this British Standard shall be legibly marked with UK cable code"
  modality SHALL
  reference {
    BS6004:2012-ref11-1
  }
}

provision Provision46 {
  condition "The external surface of all cables conforming to this British Standard shall be legibly marked with number of cores, nominal area of conductor and circuit protective conductor as appropriate"
  modality SHALL
  reference {
    BS6004:2012-ref11-1
  }
}

provision Provision47 {
  condition "The external surface of all cables conforming to this British Standard shall be legibly marked with year of manufacture"
  modality SHALL
  reference {
    BS6004:2012-ref11-1
  }
}

provision Provision48 {
  condition "The external surface of all cables conforming to this British Standard shall be legibly marked with standard core colour identifier"
  modality SHALL
  reference {
    BS6004:2012-ref11-1
  }
}

provision Provision52 {
  condition "Conformity of the marking shall be checked by visual examination"
  modality SHALL
  reference {
    BS6004:2012-ref11-1
  }
}

provision Provision54 {
  condition "Conformity of the marking shall be checked by measurement of at least two sets of elements"
  modality SHALL
  reference {
    BS6004:2012-ref11-1
  }
}

provision Provision55 {
  condition "When the core colour combinations are used in accordance with Table 3 to Table 6 , the letter “H” shall be included in the marking on the external sheath of the cable in accordance with 11.1"
  modality SHALL
  reference {
    BS6004:2012-ref11-2
  }
}

provision Provision56 {
  condition "The mark of an approval organization shall be embossed or indented throughout the length of the external sheath of the cable"
  modality SHALL
  reference {
    BS6004:2012-ref11-3
  }
}

provision Provision57 {
  condition "The mark shall be in the form of symbol(s) specified by the approval organization"
  modality SHALL
  reference {
    BS6004:2012-ref11-3
  }
}

provision Provision58 {
  condition "the maximum distance between marks shall be not greater than 1100 mm"
  modality SHALL
  reference {
    BS6004:2012-ref11-3
  }
}

provision Provision59 {
  condition "Any additional information shall be embossed, indented or printed throughout the length of the external sheath of the cable"
  modality SHALL
  reference {
    BS6004:2012-ref11-4
  }
}

provision Provision60 {
  condition "The additional information shall be in one continuous string so that it does not conflict with, confuse nor render illegible the marking in 11.1 , 11.2 and 11.3"
