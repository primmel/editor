  }
}

subprocess Page3 {
  elements {
    Start4 {
      x 0
      y 0
    }
    GeneralIdentification {
      x -200
      y 120
    }
    CoreColours {
      x -40
      y 120
    }
    ConformityByMeasurement {
      x -40
      y 200
    }
    ClarityAndDurability {
      x 120
      y 120
    }
  }
  process_flow {
    Edge1 {
      from Start4
      to GeneralIdentification
    }
    Edge2 {
      from Start4
      to CoreColours
