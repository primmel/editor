measurement dc {
  type TRUE/FALSE
  description "The cable is for d.c."
}

measurement target {
  type TRUE/FALSE
  description "The cable is for conductor-conductor"
}

measurement type {
  type TABLE_OPTIONS
  definition "data,0,2,area,3,class"
  description "Type of cable (e.g., 6181Y)"
}

measurement area {
  type TABLE_OPTIONS
  definition "data,2,0,type,3,class"
  description "Nominal cross-sectional area of conductors"
}

measurement class {
  type TABLE_OPTIONS
  definition "data,3,2,area,0,type"
  description "Class of conductor (1 / 2)"
}

measurement OpV {
  type NUMERIC
  description "Maximum permanent operating voltage  "
}

measurement thickness {
  type NUMERIC
  description "Radial thickness of the insulation"
}

measurement thicknessReq {
  type TABLE_REFERENCE
  definition "data,4,0,type,2,area,3,class"
  description "Requirement of the radial thickness of insulation"
}

measurement sheath {
  type NUMERIC
  description "Radial thickness of the sheath "
}

measurement sheathReq {
  type TABLE_REFERENCE
  definition "data,5,0,type,2,area,3,class"
  description "Requirement of radial thickness of sheath"
}

measurement isCircular {
  type TABLE_REFERENCE
  definition "data,13,0,type"
  description "Is the cable circular"
}

measurement dimension1 {
  type NUMERIC
  description "Mean Dimension 1 (for circular and flat cables) in mm"
}

measurement dimension2 {
  type NUMERIC
  description "Mean dimension 2 (for flat cable only) in mm"
}

measurement dimension1ReqMin {
  type TABLE_REFERENCE
  definition "data,9,0,type,2,area,3,class"
  description "Minimal dimension 1"
}

measurement dimension1ReqMax {
  type TABLE_REFERENCE
  definition "data,11,0,type,2,area,3,class"
  description "Maximum dimension 1"
}

measurement dimension2ReqMin {
  type TABLE_REFERENCE
  definition "data,10,0,type,2,area,3,class"
  description "Minimum dimension 2"
}

measurement dimension2ReqMax {
  type TABLE_REFERENCE
  definition "data,12,0,type,2,area,3,class"
  description "Maximum dimension 2"
}

measurement tableRef {
  type TABLE_REFERENCE
  definition "data,14,0,type,2,area,3,class"
  description "Cable in which table"
}

measurement periodWater {
  type NUMERIC
  description "Period of immersion in water (in h) [Insulation resistance]"
}

measurement temperature {
  type NUMERIC
  description "Temperature of water for cables in °C [Insulation resistance]"
}

measurement resistance {
  type NUMERIC
  description "Insulation resistance"
}

measurement resistanceReq {
  type TABLE_REFERENCE
  definition "data,6,0,type,2,area,3,class"
  description "Requirement of minimum insulation resistance"
}

note Note6 {
  type NOTE
  message "Depending on where the cables are used, restrictions may apply to the use of certain colours for some applications"
  reference {
    BS6004:2012-ref8-2
  }
}

note Note13 {
  type EXAMPLE
  message "300/500 V"
  reference {
    BS6004:2012-ref11-1
  }
}

note Note12 {
  type EXAMPLE
  message "ELECTRIC CABLE"
  reference {
    BS6004:2012-ref11-1
  }
}

note Note7 {
  type NOTE
  message "A simplified version of the manufacturer’s name, or a trading name of the manufacturer, may be used in place of the full name."
  reference {
    BS6004:2012-ref11-1
  }
}

note Note9 {
  type NOTE
  message "Any suitable method may be used to unambiguously identify the manufacturer’s factory.
"
  reference {
    BS6004:2012-ref11-1
  }
}

note Note10 {
  type NOTE
  message "The manufacturer’s own trademark or equivalent may be added but this cannot be used instead of the manufacturer’s name or identifier."
  reference {
    BS6004:2012-ref11-1
  }
}

note Note11 {
  type EXAMPLE
  message "Manufacturer’s name and their unique factory identifier"
  reference {
    BS6004:2012-ref11-1
  }
}

note Note14 {
  type EXAMPLE
  message "BS 6004"
  reference {
    BS6004:2012-ref11-1
  }
}

note Note15 {
  type NOTE
  message "Marking BS 6004 or BS 6004:2012 on or in relation to a product represents a manufacturer’s declaration of conformity, i.e. a claim by or on behalf of the manufacturer that the product meets the requirements of the standard. The accuracy of the claim is solely the claimant’s responsibility. Such a declaration is not to be confused with third-party certification of conformity."
  reference {
    BS6004:2012-ref11-1
  }
}

note Note16 {
  type EXAMPLE
  message "6242Y"
  reference {
    BS6004:2012-ref11-1
  }
}

note Note17 {
  type NOTE
  message "The relevant UK cable code is given in Table 3 to Table 6"
  reference {
    BS6004:2012-ref11-1
  }
}

note Note18 {
  type EXAMPLE
  message "3 × 1.5"
  reference {
    BS6004:2012-ref11-1
  }
}

note Note19 {
  type EXAMPLE
  message "2 x 1.5 + 1.0"
  reference {
    BS6004:2012-ref11-1
  }
}

note Note20 {
  type NOTE
  message "3 × 1.5 indicates a 3-core cable with 1.5 mm2 conductors."
}

note Note21 {
  type NOTE
  message "2 × 1.5 + 1.0 indicates a 2-core cable with 1.5 mm2 conductors and a 1.0 mm2 CPC."
  reference {
    BS6004:2012-ref11-1
  }
}

note Note22 {
  type EXAMPLE
  message "ZZZZ"
  reference {
    BS6004:2012-ref11-1
  }
}

note Note23 {
  type NOTE
  message "The year of manufacture may take the form of the actual year (e.g. 2013) or a coded year identifier assigned by the manufacturer."
  reference {
    BS6004:2012-ref11-1
  }
}

note Note24 {
  type EXAMPLE
  message "H"
  reference {
    BS6004:2012-ref11-1
  }
}

note Note25 {
  type NOTE
  message "See 11.2"
  reference {
    BS6004:2012-ref11-1
  }
}

note Note27 {
  type COMMENTARY
  message "In some tests, the preparation and presentation of the test sample can have a critical affect on the result of the tests so test samples should always be prepared carefully"
  reference {
    BS6004:2012-ref14
  }
}

note Note28 {
  type NOTE
  message "The requirements for routine testing that are not fully covered by earlier clauses are detailed in 14.2 and 14.3"
  reference {
    BS6004:2012-ref14-1
  }
}

note Note29 {
  type COMMENTARY
  message "In some tests, the preparation and presentation of the test sample can have a critical affect on the result of the tests so test samples should always be prepared carefully"
  reference {
    BS6004:2012-ref15
  }
}

note Note30 {
  type NOTE
  message "The requirements for sample testing that are not fully covered by earlier clauses are detailed in 15.2, 15.3, 15.4 and 15.5"
  reference {
    BS6004:2012-ref15-1
  }
}

note Note31 {
  type COMMENTARY
  message "In some tests, the preparation and presentation of the test sample can have a critical affect on the result of the tests so test samples should always be prepared carefully"
  reference {
    BS6004:2012-ref16
  }
}

note Note32 {
  type NOTE
  message "The requirements for type testing that are not fully covered by earlier clauses are detailed in 16.2, 16.3, 16.4, 16.5, 16.6 , and 16.7"
  reference {
    BS6004:2012-ref16-1
  }
}

note Note33 {
  type NOTE
  message "Informative notes on type tests can be found in Annex F"
  reference {
    BS6004:2012-ref16-1
  }
}

note Note3 {
  type NOTE
  message "Other colours may be used by agreement with the manufacturer; in this case the requirements in 11.2 do not apply."
  reference {
    BS6004:2012-ref8-1
  }
}

note Note1 {
  type NOTE
  message "The insulation can be applied in a single layer, or in a number of cohesive layers"
  reference {
    BS6004:2012-ref7-2
  }
}

note Note2 {
  type NOTE
  message "Insulation applied in more than one layer does not conform to the definition of “double insulation” given, for instance, in BS 7671"
  reference {
    BS6004:2012-ref7-2
  }
}

note Note4 {
  type NOTE
  message "In cases of dispute regarding the green-and-yellow combination, and where appropriate to the method of colour marking of the insulation, a suitable test method for checking conformity is given in BS EN 50396 , 5.2"
  reference {
    BS6004:2012-ref8-2
  }
}

note Note5 {
  type NOTE
  message "It is understood that the colours green and yellow, when they are combined as specified, are recognized as identifying exclusively the core intended for use as an earth connection or similar protection. The colour blue is for the identification of the core intended to be connected to neutral but, if there is no neutral, blue may be used to identify any core except for the earth or protective conductor"
  reference {
    BS6004:2012-ref8-2
  }
}

note Note8 {
  type NOTE
  message "The sheath can be applied in a single layer or in a number of cohesive layers"
  reference {
    BS6004:2012-ref10-2
  }
}

note Note34 {
  type NOTE
  message "Tests classified as sample (S) or routine (R ) might be required as part of a type approval scheme."
  reference {
    BS6004:2012-ref12
  }
}

note Note35 {
  type NOTE
  message "The order of the tests in this schedule does not imply a sequence of testing"
  reference {
    BS6004:2012-ref12
  }
}

note Note26 {
  type NOTE
  message "The order in which the elements of marking appear along the length of the external sheath is not prescribed, but it is preferred that they be in the order from left to right as shown in the subprocess"
  reference {
    BS6004:2012-ref11-1
  }
}

