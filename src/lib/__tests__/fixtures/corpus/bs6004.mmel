  reference {
    BS6004:2012-ref11-4
  }
}

provision Provision64 {
  condition "Tests shall be performed at a temperature of (20 ±15) °C unless otherwise specified in the details for a particular test"
  modality SHALL
  reference {
    BS6004:2012-ref13-1
  }
}

provision Provision65 {
  condition "The frequency of the alternating test voltages shall be in the range of 49 Hz to 61 Hz unless otherwise specified in the details for a particular test"
  modality SHALL
  reference {
    BS6004:2012-ref13-2
  }
}

provision Provision66 {
  condition "The waveform shall be substantially sinusoidal"
  modality SHALL
  reference {
