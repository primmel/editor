    Provision7
  }
}

process CrimsonContext {
  name "Crimson Context"
  validate_provision {
    Provision8
  }
}

process SoA {
  name "Statement of applicability"
  validate_provision {
    Provision9
  }
}

process Meetings {
  name "Meetings"
  validate_provision {
    Provision10
  }
  subprocess Page2
}

start_event Start0 {
}

start_event Start1 {
}

start_event Start2 {
}

process ManagementReview {
  name "Management Review"
}

process RiskAssessments {
