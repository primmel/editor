}

provision Provision14 {
  condition "Records: ribose-iso/records/attendance-lists/ISO_27001_Lead_Auditor_Training"
}

provision Provision15 {
  condition "Records: ribose-iso/records/attendance-lists/ISO_27001_Awareness_training"
}

provision Provision16 {
  condition "Visitor registration system in google drive"
}

provision Provision17 {
  condition "By BSI"
}

