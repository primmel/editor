    Provision13
  }
}

start_event Start4 {
}

process ISO27001LeadAuditorTraining {
  name "ISO 27001 Lead Auditor Training"
  validate_provision {
    Provision14
  }
}

process ISO27001AwarenessTraining {
  name "ISO 27001 Awareness Training"
  validate_provision {
    Provision15
  }
}

process InternalAudit {
  name "Internal Audit"
}

process RiboseScrum {
  name "Ribose Scrum"
}

start_event Start5 {
}

process Recruitment {
  name "Recruitment"
