}

process Screening {
  name "Screening"
}

process SignContract {
  name "Sign employment contract"
}

process Termination {
  name "Termination"
}

process InventoryList {
  name "Inventory List"
}

process AWS {
  name "AWS"
}

process RiboseOperationWiki {
  name "Ribose Operation Wiki"
}

process VisitorRegistrationSystem {
  name "Visitor registration system"
  validate_provision {
    Provision16
  }
}

process CCTV {
  name "CCTV"
}

process ADTSecuritySystem {
  name "ADT Security System"
}

process Wifi {
  name "Wifi"
}

process Papertrail {
  name "Papertrail"
}

process Platforms {
  name "Platforms"
