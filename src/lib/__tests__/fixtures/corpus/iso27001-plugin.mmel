}

start_event Start6 {
}

process Jenkins {
  name "Jenkins"
}

process ApprovedSuppliers {
  name "Approved Suppliers"
}

process Testing {
  name "Testing"
  subprocess Page7
}

start_event Start7 {
}

process BrowserTest {
  name "Browser test"
}

process UnitTest {
  name "Unit Test"
}

process Brakeman {
  name "Brakeman"
}

process ribose.com {
  name "ribose.com"
}

process ExternalAudit {
  name "External Audit"
  validate_provision {
    Provision17
  }
}

process MonitorTraffic {
  name "Monitor AWS traffic"
  subprocess Page8
}

start_event Start8 {
}

process FailedLoginMonitor {
  name "Failed login monitoring"
  validate_measurement {
    "[NumFailLogin] / [NumLogin] <= 0.4"
  }
}

process TrafficMonitor {
  name "Traffic monitor"
  validate_measurement {
    "[NumConnection].max <= 100"
  }
}

provision Provision1 {
  condition "Crimson is Ribose's internal manual system, providing manual documents (e.g., policy and procedures) for staff"
}

provision Provision2 {
  condition "URL: https://crimson.ribose.com"
}

provision Provision4 {
  condition "URL: https://crimson.ribose.com/documents/crimson-policies/document.html"
}

provision Provision5 {
  condition "URL: https://crimson.ribose.com/documents/crimson-procedures/document.html"
}

provision Provision3 {
  condition "URL: https://crimson.ribose.com/documents/crimson-requirements/document.html"
}

provision Provision6 {
  condition "URL: https://crimson.ribose.com/documents/crimson-guidelines/document.html"
}

provision Provision7 {
