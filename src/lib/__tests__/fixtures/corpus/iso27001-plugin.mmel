root Root

version "v1.0.0-dev1"

metadata {
  title "Ribose Crimson"
  schema "MMEL 1.0"
  edition "30-07-2021"
  author "Ribose"
  shortname "Ribose"
  namespace "RiboseISO27001"
}

process Crimson {
  name "Crimson"
  validate_provision {
    Provision1
    Provision2
  }
  subprocess Page1
}

process CrimsonRequirements {
  name "Crimson  Requirements"
