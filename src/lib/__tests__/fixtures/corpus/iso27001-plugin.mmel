}

provision Provision10 {
  condition "Meeting records: ribose-iso/records/meetings"
}

provision Provision11 {
  condition "URL: https://crimson.ribose.com/documents/crimson-risk-assessments/document.html"
}

provision Provision12 {
  condition "URL: https://crimson.ribose.com/documents/crimson-objectives-and-programs/document.html"
}

provision Provision13 {
