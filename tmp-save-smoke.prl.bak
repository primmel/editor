root Root

metadata {
  title "Manufacturing Pipeline"
  schema "Primmel 0.1"
  edition ""
  author ""
  namespace "Manufacturing"
}

role Factory {
  name "Factory"
}
role AssemblyLine {
  name "Assembly Line"
}
role QA {
  name "Quality Assurance"
}
process Manufacturing {
  name "Manufacture v2"
  actor Factory
  process Assembly {
    name "Assemble components"
    actor AssemblyLine
    parent Manufacturing
  }

  process QualityControl {
    name "Inspect quality"
    actor QA
    parent Manufacturing
  }
}
start_event Start {
}
end_event Done {
}
canvas Root {
  elements {
    Start {
      x 0
      y 0
    }
    Manufacturing {
      x 0
      y 100
    }
    Done {
      x 0
      y 200
    }
  }
  process_flow {
    E1 {
      from Start
      to Manufacturing
    }
    E2 {
      from Manufacturing
      to Done
    }
  }
  data {
  }
}
