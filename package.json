{
  "name": "primmel-editor",
  "version": "0.2.0",
  "type": "module",
  "private": false,
  "description": "The Primmel Studio editor — the model canvas, inspectors, mapper, and review surface for the Primmel v3 kernel. Program layers (OIML SMART first) plug in via the registry; the editor stays program-agnostic.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/primmel/editor.git"
  },
  "homepage": "https://github.com/primmel/editor#readme",
  "license": "MIT",
  "author": "Ribose Inc. <open.source@ribose.com>",
  "keywords": ["primmel", "oiml", "smart", "metrology", "editor", "modelling", "recommendation"],
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*",
    "./styles/*": "./src/styles/*"
  },
  "files": ["src"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/audit-typing.mjs && vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "audit:types": "node scripts/audit-typing.mjs"
  },
  "peerDependencies": {
    "vue": ">=3.5",
    "pinia": ">=3",
    "monaco-editor": ">=0.50",
    "@primmel/primmel": "^1.4.0",
    "@oimlsmart/oiml-pubid": "*",
    "js-yaml": ">=4"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "linkedom": "^0.18.13",
    "puppeteer": "^25.4.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.5",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
